# Copy this file to .env.local and fill in both keys. .env.local is not committed.

# YouTube Data API v3 key — https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: use a different Gemini model than the default in lib/gemini.ts
# GEMINI_MODEL=
